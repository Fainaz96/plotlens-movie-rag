# Backend
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATASET_PATH=data/movies.csv
EMBEDDING_CACHE_DIR=backend/.cache/embeddings
FRONTEND_ORIGIN=http://localhost:3100
OPENAI_TIMEOUT_SECONDS=45

# Frontend (baked into the browser bundle)
# Optional: leave unset for the Next.js /backend proxy during native development.
NEXT_PUBLIC_API_URL=
